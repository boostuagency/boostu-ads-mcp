# BoostU Ads MCP: copy to .env and fill in the platforms you use (see docs/AUTHENTICATION.md).
# Every platform is optional; tools appear only for platforms with complete credentials.

# ---------- Google (Ads, GA4, Search Console) ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Refresh token of a Google user with access to your accounts (scripts/get-refresh-token.mjs google)
GOOGLE_REFRESH_TOKEN=
# Optional separate refresh tokens per product
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ANALYTICS_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
# Manager account (MCC) id, with or without dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional and ignored by Google since 9 Sep 2026; access follows the OAuth client's Cloud project
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25

# ---------- Meta (Facebook / Instagram) ----------
# System user token with ads_read (and ads_management for writes)
META_ACCESS_TOKEN=
META_APP_SECRET=
META_BUSINESS_ID=
META_API_VERSION=v26.0
# Action types counted as conversions in cross-channel totals
META_CONVERSION_ACTIONS=purchase,lead

# ---------- LinkedIn Ads ----------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
# or, without programmatic refresh:
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202609

# ---------- TikTok Ads ----------
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# ---------- Microsoft Advertising ----------
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_CUSTOMER_ID=
MICROSOFT_ADS_TENANT=common

# ---------- Behaviour ----------
# confirm (default): write tools preview first and need confirm=true. off: write tools are hidden.
WRITE_MODE=confirm
# --http mode only: API key names allowed to execute writes (empty = all keys)
WRITE_ALLOWED_USERS=
# Client registry (see clients.example.json): inline JSON or a file path
CLIENTS_JSON=
CLIENTS_FILE=clients.json
REPORT_TIMEZONE=Europe/Brussels
MAX_RESPONSE_CHARS=120000
DEBUG=false

# ---------- --http mode ----------
PORT=3000
# name:key pairs, comma separated. Clients send "Authorization: Bearer <key>".
MCP_API_KEYS=
